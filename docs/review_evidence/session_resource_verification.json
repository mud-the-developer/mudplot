  "collector_source": "import ctypes\nfrom ctypes import wintypes\nimport gc\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport time\n\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nfrom matplotlib.figure import Figure\nimport mudplot as mp\nfrom mudplot.spec import LayerSpec\nfrom dashboard.editor_server import EditorSession\nfrom scripts.check_request_body_limits import _memory\n\nF = Path(__file__).parent\nkernel = ctypes.WinDLL('kernel32', use_last_error=True)\nkernel.GetCurrentProcess.restype = wintypes.HANDLE\nkernel.GetProcessHandleCount.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]\nkernel.GetProcessHandleCount.restype = wintypes.BOOL\nstarted = time.monotonic()\nrows = []\nbase = mp.plot({'x':list(range(500)), 'y':[i%17 for i in range(500)], 'notes':['synthetic']*500}).line('x','y').size(4,3).spec\nbase.dpi = 72\ntext = mp.to_json(base)\nsession = EditorSession()\nsession.load_spec(text)\n\ndef handles():\n    count = wintypes.DWORD()\n    if not kernel.GetProcessHandleCount(kernel.GetCurrentProcess(), ctypes.byref(count)):\n        raise ctypes.WinError(ctypes.get_last_error())\n    return count.value\n\ndef observed():\n    return {**_memory(os.getpid()), 'handles':handles(), 'gc_objects':len(gc.get_objects()), 'live_figures':sum(isinstance(o,Figure) for o in gc.get_objects()), 'open_figures':len(plt.get_fignums())}\n\ndef emit(phase, index):\n    before = observed()\n    gc.collect()\n    after = observed()\n    row = {'phase':phase,'iteration':index,'seconds':time.monotonic()-started,'history':len(session.store.history),'action_log_bytes':len(json.dumps(session.action_log()).encode()),'cache_png_bytes':len(session.png),'cache_layout_bytes':len(json.dumps(session.layout).encode()),'before_gc':before,'after_gc':after,'temp_files':sorted(str(p.relative_to(F/'tmp')) for p in (F/'tmp').rglob('*') if p.is_file())}\n    rows.append(row)\n    print(json.dumps(row), flush=True)\n    assert after['open_figures']==0\n    if after['rss_bytes'] > 512*1024*1024:\n        raise RuntimeError('observation RSS budget exceeded')\n\nfor i in range(3):\n    session.dispatch_safe(mp.actions.SetTitle(text=f'warm-{i}'))\n    session.undo();session.redo()\nfor fmt in ('pdf','svg'):\n    assert session.export(fmt)\nassert mp.to_json(session.store.state)\nsession.load_spec(text)\nemit('warm_baseline',0)\nfor phase in ('history_growth','fixed_history_replace'):\n    for i in range(1,31):\n        if phase=='fixed_history_replace':session.load_spec(text)\n        session.dispatch_safe(mp.actions.SetTitle(text=f'{phase}-{i}'))\n        assert session.error is None\n        session.undo();assert session.error is None\n        session.redo();assert session.error is None\n        assert session.store.state.panels[0].title==f'{phase}-{i}'\n        if i%5==0:\n            for fmt in ('pdf','svg'):\n                data=session.export(fmt);assert data\n            del data\n            emit(phase,i)\n    if phase=='history_growth':assert len(session.store.history)==30\n    else:assert len(session.store.history)==1\nfor i in range(10):\n    before_spec=mp.to_json(session.store.state);before_png=session.png\n    session.dispatch_safe(mp.actions.AddLayer(layer=LayerSpec(type='line',x='x',y='y',color='invalid-resource-probe-colour')))\n    assert session.error and mp.to_json(session.store.state)==before_spec and session.png==before_png\nemit('failed_effects_preserve_state',10)\nsession.load_spec(text)\nemit('reopen_clean',1)\nassert len(session.store.history)==0\nresult={'rows':rows,'elapsed_seconds':time.monotonic()-started,'phases':{'history_growth':30,'fixed_history_replace':30,'failed_effects':10},'warmups':3,'data_rows':500,'render_count_lower_bound':240,'final_spec_sha256':hashlib.sha256(mp.to_json(session.store.state).encode()).hexdigest(),'scope':'One Windows in-process PythonEditor session, owned figures and ownPID RSS/handles/temp directory only. Native RSS includes backend/cache/allocator effects. Not Rust/Python child lifetime/leak, hours-long GUI, hard memory cap, concurrency or all hardware guarantee.'}\n(F/'result.json').write_text(json.dumps(result,indent=2),encoding='utf-8')\nprint(json.dumps({'completed':True,'elapsed_seconds':result['elapsed_seconds']}),flush=True)\n",
