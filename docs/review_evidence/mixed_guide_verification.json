  "visual_baseline": {
    "path": "mixed_guides_baseline.png",
    "sha256": "ffbdb2bc7edaabb6522ddea5fa11006a4d7bd927dc78c00d31696b1a47b40850",
    "scope": "6x3inch dense two-panel guide diagnostic. Not pixel-golden cross-environment or a general aesthetic optimum; wider size gives more data area."
  },
  "fix": "Measure visible secondary-axis labels/ticks/offsets and place named outside-right legend with a physical ScaledTranslation rather than a fixed1.35axes fraction. Bounded preliminary draws and final check preserve canvas/no manual-anchor movement. Collapse repeated explicit ungrouped point/line(2D/3D) guides with identical axis/x/y/z/label/citation/href, keep first handle.",
  "identity_limits": "Grouped/semantic guides retain existing identity handling. Raw1 versus string1, different source columns/axes/references and marker sources are not collapsed. This is not universal visible-string-only deduplication or arbitrary artist layout.",
  "qa_controls": "Initial tests lacked Legend non-None assertions; added actual existence checks. Measuring an Agg cached text renderer after vector save used incompatible renderer state; corrected to actual save draw_event renderer. Private script initially expected warning for all small variants even the fitting nonsecondary case, then omitted spec argument to private _save_figure; corrected controls, no product fixes/false pass counts. Partial edit applied7blocks before one context mismatch; reread and added only missing secondary metadata block, not duplicated edits.",
  "limits": "Measured sizes8x3.5 and6x3 support this two-panel/two-colorbar/sharex/y+y2corpus;4.5x2.8secondary warns. No auto canvas/font changes, no allUnicode/font/OS/complex-layout promise. Fields/version/dependencies unchanged.",
  "checks": [
